# Copy to .env to override defaults used by docker-compose.yml
# (every value shown here is also the built-in default).

# Redis is the Celery broker and result backend. Inside compose the host is the service name.
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO

# Host port the API (and frontend) is published on
API_PORT=8000

# Comma-separated origins allowed to call the API cross-origin
CORS_ORIGINS=*

# Demo task duration in seconds, and Celery worker processes
TASK_DELAY_SECONDS=5
WORKER_CONCURRENCY=2
