# Worker image: Celery worker only (no frontend, no exposed port). Build context is the repo root:
#   docker build -f backend/Dockerfile.worker -t notify-worker .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY backend/ .

RUN useradd --system --uid 10001 app && chown -R app /app
USER app

# Shell form so LOG_LEVEL / WORKER_CONCURRENCY are expanded at start-up.
CMD ["sh", "-c", "celery -A worker.celery_app worker --loglevel=${LOG_LEVEL:-INFO} --concurrency=${WORKER_CONCURRENCY:-2}"]
